page {
  background-color: #F9F7F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #2A4B3C;
}

button::after {
  border: none;
}

.app-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 44rpx 30rpx 64rpx;
}

.app-header {
  margin-bottom: 34rpx;
}

.app-eyebrow {
  color: #C1A268;
  display: block;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.app-title {
  color: #2A4B3C;
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.app-subtitle {
  color: #68716C;
  display: block;
  font-size: 23rpx;
  line-height: 1.7;
  margin-top: 10rpx;
}

.app-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #E8EDE7;
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 28rpx 26rpx;
}

.app-card-label {
  color: #C1A268;
  display: block;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}

.app-card-title {
  color: #2A4B3C;
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.app-card-copy {
  color: #68716C;
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
  margin-top: 12rpx;
}

.app-primary-button,
.app-secondary-button {
  border-radius: 0;
  font-size: 27rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.app-primary-button {
  background: #2A4B3C;
  color: #FFFFFF;
}

.app-secondary-button {
  background: transparent;
  border: 1rpx solid #E8EDE7;
  color: #2A4B3C;
}

.app-state {
  color: #868C88;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 42rpx 20rpx;
  text-align: center;
}

.app-state.error {
  color: #A34837;
}

/* WebApp globals.css 的公共绿色体系；小程序页面不得自行发明近似色。 */
.green-gradient {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
}

.green-gradient-deep {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.85), rgba(45, 90, 39, 0.95));
}

.green-gradient-light {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.1), rgba(45, 90, 39, 0.15));
}

.green-gradient-1 {
  background-color: #C4CCBE;
}

.green-gradient-2 {
  background-color: #8DA688;
}

.green-gradient-3 {
  background-color: #4A7A44;
}

.green-gradient-4 {
  background-color: #1A3D1A;
}
