.password-mask{align-items:center;background:rgba(0,0,0,.4);bottom:0;box-sizing:border-box;display:flex;justify-content:center;left:0;overflow-y:auto;padding:32rpx;position:fixed;right:0;top:0;z-index:280;-webkit-overflow-scrolling:touch}.password-modal{background:#FCFBF7;border-radius:48rpx;box-shadow:0 16rpx 64rpx rgba(0,0,0,.12);box-sizing:border-box;margin:auto;max-height:none;overflow:visible;padding:48rpx 40rpx 56rpx;width:100%}.password-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:36rpx}.password-title{color:#2A4B3C;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:34rpx}.password-close{align-items:center;color:#868C88;display:flex;font-size:44rpx;height:64rpx;justify-content:center;line-height:1;margin-right:-16rpx;width:64rpx}.password-fields{display:flex;flex-direction:column;gap:28rpx}.password-field{display:flex;flex-direction:column;gap:12rpx}.password-label{color:#2A4B3C;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:25rpx;font-weight:500}.password-input-wrap{align-items:center;background:#F5F2EC;border:1rpx solid #E7E2D8;border-radius:24rpx;display:flex;padding:0 22rpx}.password-input-icon{flex-shrink:0;height:36rpx;width:36rpx}.password-input{box-sizing:border-box;color:#2A4B3C;flex:1;font-size:25rpx;height:88rpx;padding-left:18rpx}.password-error{background:#FEF2F2;border-radius:16rpx;color:#DC2626;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:23rpx;margin-top:24rpx;padding:20rpx 22rpx}.password-rules{background:transparent;border-radius:0;color:#868C88;display:flex;flex-direction:column;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:21rpx;gap:7rpx;margin-top:22rpx;padding:0 0 0 8rpx}.password-rules .passed{color:#2D7A45}.password-rules .failed{color:#B94A48}.password-actions{display:grid;gap:20rpx;grid-template-columns:1fr 1fr;margin-top:30rpx}.password-action{border-radius:24rpx;box-sizing:border-box;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:25rpx;line-height:1.4;margin:0;padding:23rpx 16rpx;width:100%}.password-cancel{background:#F5F2EC;border:1rpx solid #E7E2D8;color:#2A4B3C}.password-confirm{background-image:linear-gradient(to top left,rgba(74,122,68,.7),rgba(45,90,39,.85));border:1rpx solid rgba(255,255,255,.2);box-shadow:0 8rpx 32rpx rgba(45,90,39,.25);color:#FFFFFF}.password-action-disabled{opacity:.5}
