.share-mask{align-items:center;background:rgba(0,0,0,.5);bottom:0;box-sizing:border-box;display:flex;justify-content:center;left:0;padding:24rpx;position:fixed;right:0;top:0;z-index:120}.share-modal{align-items:center;display:flex;flex-direction:column;gap:18rpx;max-width:calc(100vw - 48rpx);width:320px}.share-preview-scroll{background:#FFF;border-radius:24px;box-shadow:0 16rpx 60rpx rgba(0,0,0,.22);max-height:70vh;max-width:100%;position:relative;width:320px}.share-preview-content{min-height:100%;min-width:100%;position:relative}.share-canvas{background:#FFF;display:block;transform-origin:left top}.rendering-mask{align-items:center;background:rgba(255,255,255,.82);bottom:0;color:#68716C;display:flex;flex-direction:column;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:22rpx;gap:14rpx;justify-content:center;left:0;position:absolute;right:0;top:0}.rendering-spinner{animation:share-spin .8s linear infinite;border:4rpx solid rgba(45,90,39,.18);border-radius:50%;border-top-color:#2D5A27;height:38rpx;width:38rpx}.zoom-controls{align-items:center;background:rgba(252,251,247,.96);border:1rpx solid rgba(255,255,255,.3);border-radius:999rpx;display:flex;height:60rpx;justify-content:center;padding:0 8rpx}.zoom-button{align-items:center;color:#2A4B3C;display:flex;font-size:34rpx;height:52rpx;justify-content:center;width:58rpx}.zoom-value{color:#68716C;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:22rpx;text-align:center;width:82rpx}.share-actions{display:flex;gap:24rpx;max-width:100%;width:320px}.share-button{border-radius:999rpx;box-sizing:border-box;flex:1;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:28rpx;padding:24rpx 0;text-align:center}.share-button.secondary{background:#F5F2EC;color:#2A4B3C}.share-button.primary{background-image:linear-gradient(to top left,rgba(74,122,68,.7),rgba(45,90,39,.85));border:1rpx solid rgba(255,255,255,.2);box-shadow:0 8rpx 28rpx rgba(45,90,39,.25);color:#FFF}.share-button.disabled{opacity:.55}@keyframes share-spin{to{transform:rotate(360deg)}}
