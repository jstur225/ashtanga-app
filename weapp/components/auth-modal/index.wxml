<view wx:if="{{show}}" class="auth-mask" bindtap="close" catchtouchmove="stopPropagation">
  <scroll-view class="auth-card" scroll-y catchtap="stopPropagation">
    <view class="auth-inner">
      <view class="auth-heading">
        <text class="auth-title">{{mode === 'register' ? '📧 绑定邮箱账号' : mode === 'forgot-password' ? '🔑 忘记密码' : '🔐 登录'}}</text>
        <text wx:if="{{mode === 'forgot-password'}}" class="heading-link" bindtap="backToLogin">返回登录</text>
        <text wx:else class="auth-close" bindtap="close">×</text>
      </view>
      <text wx:if="{{mode === 'register'}}" class="register-gift">🎁 绑定邮箱即享31天Pro会员</text>

      <block wx:if="{{mode === 'login'}}">
        <form class="auth-form-stack" bindsubmit="submitAuth">
          <view class="auth-field"><text class="field-label">邮箱地址</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-mail.svg" mode="aspectFit" /><input class="auth-input" name="email" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" /></view></view>
          <view class="auth-field"><text class="field-label">密码</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="auth-input" name="password" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" /></view><text class="forgot-link" bindtap="openForgotPassword">忘记密码？</text></view>
          <view wx:if="{{message}}" class="auth-message {{messageType}}">{{message}}</view>
          <view class="login-submit-group">
            <button class="full-submit auth-primary-button login-submit-button {{submitLoading || !hasAgreed ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" form-type="submit" hover-class="none"><text class="auth-submit-text">{{submitLoading ? '登录中...' : '登录'}}</text></button>
            <checkbox-group class="agreement-row login-agreement-row" bindchange="onAgreementChange"><checkbox class="agreement-checkbox" value="agreed" checked="{{hasAgreed}}" color="#2A4B3C" /><view class="agreement-copy"><text>我已阅读并同意</text><text class="agreement-link" data-type="terms" catchtap="onOpenAgreement">《用户协议》</text><text>和</text><text class="agreement-link" data-type="privacy" catchtap="onOpenAgreement">《隐私政策》</text></view></checkbox-group>
          </view>
        </form>
      </block>

      <block wx:elif="{{mode === 'register'}}">
        <block wx:if="{{registerStep === 'form'}}">
          <view class="auth-form-stack">
            <view class="auth-field"><text class="field-label">邮箱地址</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-mail.svg" mode="aspectFit" /><input class="auth-input" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" /></view></view>
            <view class="auth-field"><text class="field-label">密码</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="auth-input" password placeholder="至少8位字符" value="{{password}}" bindinput="onPasswordInput" /></view></view>
            <view wx:if="{{password}}" class="password-rules"><text>密码要求：</text><text class="{{passwordLengthValid ? 'valid' : 'invalid'}}">{{passwordLengthValid ? '✓' : '✗'}} 至少8位字符</text><text class="{{passwordLetterValid ? 'valid' : 'invalid'}}">{{passwordLetterValid ? '✓' : '✗'}} 包含字母</text><text class="{{passwordNumberValid ? 'valid' : 'invalid'}}">{{passwordNumberValid ? '✓' : '✗'}} 包含数字</text></view>
            <view wx:if="{{message}}" class="auth-message {{messageType}}">{{message}}</view>
            <checkbox-group class="agreement-row agreement-before-actions" bindchange="onAgreementChange"><checkbox class="agreement-checkbox" value="agreed" checked="{{hasAgreed}}" color="#2A4B3C" /><view class="agreement-copy"><text>我已阅读并同意</text><text class="agreement-link" data-type="terms" catchtap="onOpenAgreement">《用户协议》</text><text>和</text><text class="agreement-link" data-type="privacy" catchtap="onOpenAgreement">《隐私政策》</text></view></checkbox-group>
            <view class="full-submit auth-primary-button {{codeLoading || !hasAgreed ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" role="button" bindtap="sendCode"><text class="auth-submit-text">{{codeLoading ? '发送中...' : '发送验证码'}}</text></view>
            <text class="storage-consent-copy">绑定邮箱即表示您同意我们存储您的数据</text>
          </view>
        </block>
        <block wx:else>
          <view class="auth-form-stack">
            <view class="verification-notice"><text>验证码已发送到：</text><text class="verification-email">{{email}}</text></view>
            <view class="auth-field"><text class="field-label">请输入6位验证码</text><input class="auth-input verify-input" type="number" maxlength="6" placeholder="______" value="{{verificationCode}}" bindinput="onCodeInput" /></view>
            <view class="full-submit auth-primary-button {{submitLoading || verificationCode.length !== 6 ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" role="button" bindtap="submitAuth"><text class="auth-submit-text">{{submitLoading ? '注册中...' : '确认并注册'}}</text></view>
            <text class="resend-link" bindtap="resendRegisterCode">{{resendCountdown > 0 ? '重新发送(' + resendCountdown + 's)' : '重新发送验证码'}}</text>
            <view wx:if="{{message}}" class="auth-message {{messageType}}">{{message}}</view>
          </view>
        </block>
      </block>

      <block wx:else>
        <view class="auth-form-stack">
          <block wx:if="{{forgotStep === 'email'}}"><view class="auth-field"><text class="field-label">邮箱地址</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-mail.svg" mode="aspectFit" /><input class="auth-input" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" /></view></view><view class="full-submit auth-primary-button {{codeLoading || resendCountdown > 0 ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" role="button" bindtap="sendResetCode"><text class="auth-submit-text">{{codeLoading ? '发送中...' : resendCountdown > 0 ? '重新发送（' + resendCountdown + 's）' : '发送验证码'}}</text></view></block>
          <block wx:elif="{{forgotStep === 'verify'}}"><view class="verification-notice"><text>验证码已发送到：</text><text class="verification-email">{{email}}</text></view><view class="auth-field"><text class="field-label">请输入6位验证码</text><input class="auth-input verify-input" type="number" maxlength="6" placeholder="______" value="{{verificationCode}}" bindinput="onCodeInput" /></view><view class="full-submit auth-primary-button {{submitLoading || verificationCode.length !== 6 ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" role="button" bindtap="verifyForgotCode"><text class="auth-submit-text">{{submitLoading ? '验证中...' : '下一步'}}</text></view><text class="resend-link" bindtap="sendResetCode">{{resendCountdown > 0 ? '重新发送（' + resendCountdown + 's）' : '重新发送验证码'}}</text></block>
          <block wx:else><view class="verification-success">✓ 验证成功，请设置新密码</view><view class="auth-field"><text class="field-label">新密码</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="auth-input" password placeholder="至少8位，包含字母和数字" value="{{newPassword}}" bindinput="onNewPasswordInput" /></view></view><view class="auth-field"><text class="field-label">确认新密码</text><view class="input-wrap"><image class="auth-input-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="auth-input" password placeholder="再次输入新密码" value="{{confirmNewPassword}}" bindinput="onConfirmNewPasswordInput" /></view></view><view class="full-submit auth-primary-button {{submitLoading ? 'action-disabled' : ''}}" style="{{primaryButtonStyle}}" role="button" bindtap="submitNewPassword"><text class="auth-submit-text">{{submitLoading ? '修改中...' : '确认修改'}}</text></view></block>
          <view wx:if="{{message}}" class="auth-message {{messageType}}">{{message}}</view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>

<view wx:if="{{agreementVisible}}" class="agreement-mask" catchtouchmove="stopPropagation" bindtap="onCloseAgreement"><view class="agreement-modal" catchtap="stopPropagation"><view class="agreement-header"><view><text class="agreement-eyebrow">{{agreement.englishTitle}}</text><text class="agreement-title">{{agreement.title}}</text></view><text class="agreement-close" bindtap="onCloseAgreement">×</text></view><scroll-view class="agreement-scroll" scroll-y><text class="agreement-date">更新日期：{{agreement.updatedAt}}</text><block wx:for="{{agreement.intro}}" wx:key="*this"><text class="agreement-paragraph">{{item}}</text></block><block wx:for="{{agreement.sections}}" wx:key="title"><view class="agreement-section {{item.important ? 'important' : ''}}"><text wx:if="{{item.important}}" class="important-label">重要提示</text><text class="agreement-section-title">{{item.title}}</text><block wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this"><text class="agreement-paragraph">{{paragraph}}</text></block></view></block><view class="agreement-spacer"></view></scroll-view><button class="agreement-read" bindtap="onCloseAgreement">我已阅读，返回勾选</button></view></view>
