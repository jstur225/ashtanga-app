.account-guest-panel{box-sizing:border-box;width:100%}.local-storage-notice{background:linear-gradient(135deg,rgba(255,247,237,.92),rgba(255,237,213,.72));border:2rpx solid rgba(251,146,60,.3);border-radius:48rpx;box-shadow:0 8rpx 32rpx rgba(251,146,60,.12);box-sizing:border-box;margin-bottom:28rpx;padding:28rpx 30rpx;width:100%}.local-storage-title{color:#9A3412;display:block;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:26rpx;font-weight:600}.local-storage-copy{color:#C2410C;display:block;font-size:22rpx;line-height:1.7;margin-top:14rpx}.notice-divider-row,.notice-status-row{align-items:center;border-top:1rpx solid rgba(251,146,60,.2);color:#9A3412;display:flex;font-size:21rpx;gap:12rpx;line-height:1.55;margin-top:20rpx;padding-top:20rpx}.notice-divider-icon{height:34rpx;width:34rpx}.sync-status-dot{background:#A8A29E;border-radius:50%;height:12rpx;width:12rpx}.account-button-stack{align-items:stretch;box-sizing:border-box;display:flex;flex-direction:column;gap:24rpx;width:100%}.account-primary,.account-secondary{align-items:center;border-radius:48rpx;box-sizing:border-box;display:flex;font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;font-size:26rpx;font-weight:500;height:88rpx;justify-content:center;line-height:1;margin:0;padding:0 48rpx;text-align:center;width:100%}.account-primary{background-image:linear-gradient(to top left,rgba(74,122,68,.7),rgba(45,90,39,.85));border:1rpx solid rgba(255,255,255,.2);box-shadow:0 8rpx 32rpx rgba(45,90,39,.25);color:#FFFFFF}.account-secondary{background:#F5F2EC;border:1rpx solid #E8E4DC;color:#2A4B3C}.account-button-icon{flex:0 0 40rpx;height:40rpx;margin-right:16rpx;width:40rpx}.account-button-text{color:inherit;line-height:1}.account-inline-login{align-items:center;color:#868C88;display:flex;font-size:22rpx;justify-content:center;margin-top:24rpx;text-align:center;width:100%}.account-text-link{color:#2D5A27;margin-left:7rpx;text-decoration:underline}
