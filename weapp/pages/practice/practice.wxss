.practice-page {
  background: #F9F8F6;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 72rpx 48rpx calc(176rpx + env(safe-area-inset-bottom));
}

.brand-header {
  align-items: center;
  display: flex;
  justify-content: center;
  margin-bottom: 22rpx;
}

.brand-logo {
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  height: 68rpx;
  margin-right: 20rpx;
  width: 68rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-line {
  align-items: baseline;
  display: flex;
}

.brand-name,
.brand-soft,
.brand-mid {
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 34rpx;
}

.brand-name {
  color: #2A4B3C;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.brand-soft {
  color: rgba(42, 75, 60, 0.5);
}

.brand-mid {
  color: rgba(42, 75, 60, 0.72);
}

.brand-quote {
  color: rgba(42, 75, 60, 0.5);
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.today-label {
  color: #868C88;
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 22rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.practice-state {
  color: #868C88;
  font-size: 24rpx;
  padding: 70rpx 20rpx;
  text-align: center;
}

.practice-state.error {
  color: #A34837;
}

.retry-button {
  background: transparent;
  border: 1rpx solid #E8EDE7;
  border-radius: 32rpx;
  color: #2A4B3C;
  font-size: 23rpx;
  margin-top: 24rpx;
  width: 240rpx;
}

.options-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(3, 1fr);
  padding: 32rpx;
}

.option-card {
  align-items: center;
  background: #F9F8F6;
  border: 1rpx solid rgba(245, 245, 244, 0.5);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  color: #2A4B3C;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 144rpx;
  padding: 12rpx 8rpx;
  transition: transform 120ms ease, background-color 180ms ease;
}

.option-card:active {
  transform: scale(0.97);
}

.option-card.selected {
  background: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  backdrop-filter: blur(16px);
  border-color: rgba(255, 255, 255, 0.3);
  box-shadow: 0 16rpx 48rpx rgba(45, 90, 39, 0.3);
  color: #FFFFFF;
}

.option-card.custom {
  background: #F9F8F6;
  border: 2rpx dashed rgba(134, 140, 136, 0.3);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  color: #868C88;
}

.option-card.membership-locked {
  background: rgba(232, 237, 231, 0.5);
  border-color: rgba(245, 245, 244, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  position: relative;
  opacity: 0.5;
}

.option-lock-icon {
  height: 24rpx;
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  width: 24rpx;
}

.option-label-row {
  align-items: center;
  display: flex;
  justify-content: center;
}

.option-label {
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
}

.option-label.count {
  color: #C1A268;
  font-weight: 700;
}

.audio-icon {
  height: 24rpx;
  margin-left: 6rpx;
  width: 24rpx;
}

.option-notes {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 22rpx;
  line-height: 1.35;
  margin-top: 6rpx;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-card.selected .option-notes {
  color: rgba(255, 255, 255, 0.72);
}

.option-tip {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 21rpx;
  margin-top: 4rpx;
  text-align: center;
}

.start-area {
  align-items: center;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-height: 340rpx;
  padding: 36rpx 0 12rpx;
}

.start-button {
  align-items: center;
  backdrop-filter: blur(4px);
  background: rgba(232, 237, 231, 0.5);
  border: 0;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  height: 288rpx;
  justify-content: center;
  line-height: 1;
  overflow: hidden;
  padding: 0;
  width: 288rpx;
}

.start-button.ready {
  animation: breathe 3s ease-in-out infinite;
  background: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 24rpx 96rpx rgba(45, 90, 39, 0.45);
}

.start-icon {
  height: 190rpx;
  opacity: 0.62;
  width: 190rpx;
}

.start-label {
  color: #999F9B;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 26rpx;
  margin-top: 20rpx;
}

.start-label.ready {
  color: #2A4B3C;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.045); }
}

.session-page {
  background: #F9F8F6;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx 48rpx calc(84rpx + env(safe-area-inset-bottom));
  position: relative;
}

.session-main {
  align-items: center;
  display: flex;
  flex: 1;
  justify-content: center;
  min-height: 650rpx;
  position: relative;
}

.timer-ring {
  animation: timer-breathe 4s ease-in-out infinite;
  background: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  border-radius: 50%;
  box-shadow: 0 24rpx 96rpx rgba(45, 90, 39, 0.45);
  box-sizing: border-box;
  height: 440rpx;
  padding: 4rpx;
  position: relative;
  width: 440rpx;
  z-index: 2;
}

.timer-ring.paused {
  animation-play-state: paused;
}

.timer-face {
  align-items: center;
  background: rgba(249, 248, 246, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100%;
  justify-content: center;
  width: 100%;
}

.timer-minutes {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 108rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  line-height: 1;
}

.timer-unit-row {
  align-items: baseline;
  display: flex;
  gap: 5rpx;
  margin-top: 8rpx;
}

.timer-unit {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 30rpx;
}

.timer-seconds {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 23rpx;
}

.session-label {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 28rpx;
  margin-top: 20rpx;
}

.session-notes {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.breath-ripple {
  animation: session-ripple 3s ease-out infinite;
  border: 2rpx solid rgba(45, 90, 39, 0.18);
  border-radius: 50%;
  height: 440rpx;
  position: absolute;
  width: 440rpx;
}

.ripple-two {
  animation-delay: 1.5s;
}

.breath-ripple.paused {
  animation-play-state: paused;
}

.session-controls {
  display: flex;
  gap: 30rpx;
  justify-content: center;
}

.session-secondary-button,
.session-end-button {
  align-items: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 27rpx;
  height: 94rpx;
  justify-content: center;
  padding: 0 58rpx;
}

.session-secondary-button {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
  color: #2A4B3C;
  gap: 14rpx;
}

.session-end-button {
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.25);
  color: #FFFFFF;
}

.pause-icon {
  display: flex;
  gap: 5rpx;
}

.pause-bar {
  background: #2A4B3C;
  border-radius: 2rpx;
  height: 26rpx;
  width: 6rpx;
}

.play-icon {
  border-bottom: 13rpx solid transparent;
  border-left: 20rpx solid #2A4B3C;
  border-top: 13rpx solid transparent;
  height: 0;
  width: 0;
}

.practice-mask {
  align-items: center;
  background: rgba(0, 0, 0, 0.3);
  bottom: 0;
  display: flex;
  justify-content: center;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 1200;
}

.end-dialog {
  align-items: center;
  background: #FFFFFF;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  margin: 0 48rpx;
  padding: 48rpx 40rpx 34rpx;
  width: 100%;
}

.end-dialog-title {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 34rpx;
  font-weight: 600;
}

.end-dialog-copy {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 23rpx;
  line-height: 1.6;
  margin: 18rpx 0 32rpx;
  text-align: center;
}

.end-dialog-actions {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.dialog-plain-button,
.dialog-save-button {
  border-radius: 999rpx;
  box-sizing: border-box;
  flex: 1;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 24rpx;
  padding: 22rpx 12rpx;
  text-align: center;
}

.dialog-plain-button {
  background: #F9F8F6;
  border: 1rpx solid #E5E5E5;
  color: #2A4B3C;
}

.dialog-save-button {
  color: #FFFFFF;
}

.discard-button {
  color: #A34837;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 22rpx;
  margin-top: 26rpx;
  padding: 8rpx 20rpx;
}

.completion-mask {
  align-items: flex-end;
}

.completion-sheet {
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  max-height: calc(100vh - 32rpx);
  overflow-y: auto;
  padding: 18rpx 44rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.custom-option-sheet {
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  padding: 18rpx 44rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.custom-option-title {
  color: #2A4B3C;
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.sheet-handle {
  background: #D9DDD9;
  border-radius: 99rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  width: 70rpx;
}

.completion-title {
  color: #2A4B3C;
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 38rpx;
  margin-bottom: 34rpx;
  text-align: center;
}

.completion-summary {
  align-items: baseline;
  display: flex;
  justify-content: center;
  margin: 14rpx 0 30rpx;
}

.completion-form-scroll {
  max-height: calc(100vh - 220rpx - env(safe-area-inset-bottom));
}

.completion-type {
  color: #2A4B3C;
  font-size: 26rpx;
}

.completion-duration {
  color: #C1A268;
  font-size: 23rpx;
  margin-left: 20rpx;
}

.completion-field {
  margin-bottom: 24rpx;
}

.completion-label {
  color: #536D60;
  display: block;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.completion-input {
  background: #F9F8F6;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #2A4B3C;
  font-size: 25rpx;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  width: 100%;
}

.completion-textarea {
  line-height: 1.6;
  min-height: 150rpx;
}

.completion-colors {
  display: flex;
  gap: 28rpx;
  padding: 8rpx 3rpx;
}

.completion-color {
  border: 5rpx solid transparent;
  border-radius: 50%;
  box-sizing: border-box;
  height: 52rpx;
  width: 52rpx;
}

.completion-color.active {
  border-color: #FFFFFF;
  box-shadow: 0 0 0 3rpx #C1A268;
}

.completion-color.membership-locked {
  position: relative;
  opacity: 0.4;
}

.color-lock-icon {
  bottom: 0;
  height: 22rpx;
  left: 0;
  margin: auto;
  position: absolute;
  right: 0;
  top: 0;
  width: 22rpx;
}

.membership-limit-note {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(193, 162, 104, 0.25);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(249, 247, 242, 0.95), rgba(245, 240, 232, 0.92));
  color: #8b7355;
  font-size: 24rpx;
}

.membership-limit-tag {
  flex: none;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #c1a268, #d4af37);
  color: #fff;
  font-size: 18rpx;
}

.membership-disabled {
  opacity: 0.4;
}

.completion-save {
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.25);
  box-sizing: border-box;
  color: #FFFFFF;
  display: flex;
  font-size: 27rpx;
  height: 88rpx;
  justify-content: center;
  line-height: 1;
  margin-left: 0;
  margin-right: 0;
  margin-top: 8rpx;
  min-width: 0;
  padding: 0;
  width: 100%;
}

.guided-version-sheet {
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  padding: 18rpx 44rpx calc(48rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.guided-version-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.guided-version-title,
.guided-version-subtitle,
.guided-version-teacher,
.guided-version-note {
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
}

.guided-version-title {
  color: #2A4B3C;
  font-size: 34rpx;
  font-weight: 600;
}

.guided-version-subtitle {
  color: #868C88;
  font-size: 21rpx;
  margin-top: 8rpx;
}

.guided-version-close {
  height: 64rpx;
  margin-right: -16rpx;
  position: relative;
  width: 64rpx;
}

.guided-version-close-line {
  background: #868C88;
  height: 2rpx;
  left: 17rpx;
  position: absolute;
  top: 31rpx;
  width: 30rpx;
}

.guided-version-close-a { transform: rotate(45deg); }
.guided-version-close-b { transform: rotate(-45deg); }

.guided-version-scroll {
  max-height: 55vh;
}

.guided-version-option {
  align-items: center;
  background: #F9F8F6;
  border: 1rpx solid rgba(42, 75, 60, 0.12);
  border-radius: 32rpx;
  box-sizing: border-box;
  display: flex;
  gap: 22rpx;
  margin-bottom: 18rpx;
  min-height: 144rpx;
  padding: 22rpx 26rpx;
  width: 100%;
}

.guided-version-option.selected {
  background: rgba(74, 122, 68, 0.1);
  border-color: rgba(74, 122, 68, 0.4);
  box-shadow: 0 4rpx 16rpx rgba(42, 75, 60, 0.08);
}

.guided-version-icon {
  align-items: center;
  background: rgba(74, 122, 68, 0.08);
  border-radius: 50%;
  display: flex;
  flex: none;
  height: 80rpx;
  justify-content: center;
  width: 80rpx;
}

.guided-version-icon.selected {
  background: linear-gradient(135deg, #2D5A27 0%, #4A7A44 100%);
}

.guided-version-icon image {
  height: 36rpx;
  width: 36rpx;
}

.guided-version-copy {
  flex: 1;
  min-width: 0;
}

.guided-version-teacher {
  color: #2A4B3C;
  font-size: 27rpx;
}

.guided-version-note {
  color: #868C88;
  font-size: 21rpx;
  margin-top: 7rpx;
}

.guided-version-check {
  align-items: center;
  border: 2rpx solid #D9DDD9;
  border-radius: 50%;
  color: #FFFFFF;
  display: flex;
  flex: none;
  font-size: 22rpx;
  height: 44rpx;
  justify-content: center;
  width: 44rpx;
}

.guided-version-check.selected {
  background: #4A7A44;
  border-color: #4A7A44;
}

.completion-save.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.chant-settings-sheet {
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  padding: 44rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.chant-settings-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 42rpx;
}

.chant-settings-title {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 34rpx;
  font-weight: 600;
}

.chant-settings-close {
  height: 64rpx;
  margin-right: -16rpx;
  position: relative;
  width: 64rpx;
}

.chant-close-line {
  background: #868C88;
  height: 2rpx;
  left: 17rpx;
  position: absolute;
  top: 31rpx;
  width: 30rpx;
}

.chant-close-line-a { transform: rotate(45deg); }
.chant-close-line-b { transform: rotate(-45deg); }

.chant-settings-label {
  color: #2A4B3C;
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}

.chant-time-picker {
  align-items: center;
  display: flex;
  gap: 22rpx;
  justify-content: center;
}

.chant-number-column {
  align-items: center;
  display: flex;
  flex-direction: column;
}

.chant-step-button {
  align-items: center;
  border-radius: 16rpx;
  display: flex;
  height: 72rpx;
  justify-content: center;
  width: 144rpx;
}

.chant-step-button:active { background: rgba(232, 237, 231, 0.6); }

.chant-chevron {
  border-right: 3rpx solid #868C88;
  border-top: 3rpx solid #868C88;
  height: 16rpx;
  width: 16rpx;
}

.chant-chevron.up { transform: rotate(-45deg) translate(-2rpx, 2rpx); }
.chant-chevron.down { transform: rotate(135deg) translate(-2rpx, 2rpx); }

.chant-number-input {
  background: rgba(232, 237, 231, 0.6);
  border: 1rpx solid rgba(42, 75, 60, 0.08);
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 58rpx;
  font-weight: 300;
  height: 128rpx;
  line-height: 128rpx;
  padding: 0;
  text-align: center;
  width: 144rpx;
}

.chant-time-unit {
  color: #868C88;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 25rpx;
}

.chant-current-copy {
  color: rgba(134, 140, 136, 0.72);
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 21rpx;
  margin-top: 20rpx;
  text-align: center;
}

.chant-pro-row {
  align-items: center;
  color: rgba(134, 140, 136, 0.7);
  display: flex;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 21rpx;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.chant-lock-icon {
  height: 28rpx;
  opacity: 0.45;
  width: 28rpx;
}

.chant-time-picker-locked {
  opacity: 0.4;
  padding: 16rpx 0;
}

.chant-static-number {
  align-items: center;
  color: #2A4B3C;
  display: flex;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 64rpx;
  height: 220rpx;
  justify-content: center;
  width: 160rpx;
}

.chant-help-copy {
  color: #868C88;
  display: block;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 23rpx;
  line-height: 1.7;
  margin: 8rpx 0 28rpx;
}

.chant-upgrade-button {
  align-items: center;
  background: linear-gradient(to right, #F59E0B, #EAB308);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
  color: #FFFFFF;
  display: flex;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 25rpx;
  height: 84rpx;
  justify-content: center;
  width: 100%;
}

.edit-delete-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 20rpx;
}

.edit-delete-text {
  color: #A34837;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 24rpx;
}

/* ===== 唱诵倒计时遮罩 ===== */

.chant-countdown-mask {
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  bottom: 0;
  display: flex;
  flex-direction: column;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 100;
}

.chant-countdown-main {
  align-items: center;
  display: flex;
  flex: 1;
  justify-content: center;
  min-height: 650rpx;
}

.chant-countdown-circle {
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  display: flex;
  height: 440rpx;
  justify-content: center;
  width: 440rpx;
}

.chant-countdown-number {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 108rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
}

.chant-skip-button {
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
  color: #2A4B3C;
  display: flex;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 27rpx;
  height: 94rpx;
  justify-content: center;
  padding: 0 80rpx;
}

.chant-skip-area {
  align-items: center;
  display: flex;
  justify-content: center;
  padding: 0 48rpx calc(84rpx + env(safe-area-inset-bottom));
}

/* ===== 唱诵中标签 ===== */

.chant-badge {
  align-items: center;
  display: flex;
  justify-content: center;
  left: 0;
  position: absolute;
  right: 0;
  top: 32rpx;
  z-index: 10;
}

.chant-badge-text {
  background: rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  color: rgba(42, 75, 60, 0.7);
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 20rpx;
  padding: 10rpx 32rpx;
}

/* ===== 口令跟练音频 ===== */

.audio-loading-card {
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 0 0 24rpx;
  padding: 24rpx;
}

.audio-spinner {
  border: 4rpx solid rgba(42, 75, 60, 0.15);
  border-top-color: #4A7A44;
  border-radius: 50%;
  height: 48rpx;
  width: 48rpx;
  animation: audio-spin 0.8s linear infinite;
}

@keyframes audio-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.audio-loading-text {
  color: rgba(42, 75, 60, 0.7);
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 22rpx;
  margin-top: 16rpx;
}

.audio-loading-progress-track {
  background: rgba(255, 255, 255, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  position: relative;
  width: 100%;
}

.audio-loading-progress-fill {
  background: #4A7A44;
  border-radius: 999rpx;
  box-shadow: 0 0 18rpx rgba(45, 90, 39, 0.3);
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  transition: width 180ms ease;
}

.audio-error-card {
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 0 0 24rpx;
  padding: 24rpx;
}

.audio-error-text {
  color: #A34837;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 22rpx;
  text-align: center;
}

.audio-retry-button {
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  color: #FFFFFF;
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 24rpx;
  margin-top: 16rpx;
  padding: 14rpx 48rpx;
}

.audio-progress-area {
  margin: 0 0 24rpx;
  width: 100%;
}

.audio-progress-track {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(4rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  height: 12rpx;
  overflow: hidden;
  position: relative;
}

.audio-progress-fill {
  background: #4A7A44;
  border-radius: 999rpx;
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  transition: width 300ms ease;
}

.audio-time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.audio-time-label {
  color: rgba(42, 75, 60, 0.5);
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 18rpx;
}

.audio-seek-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  justify-content: center;
  margin-top: 20rpx;
}

.audio-seek-button {
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.audio-seek-icon {
  color: rgba(42, 75, 60, 0.5);
  font-size: 40rpx;
  line-height: 1;
}

.audio-seek-steps {
  display: flex;
  gap: 8rpx;
}

.audio-seek-step {
  border-radius: 999rpx;
  color: rgba(42, 75, 60, 0.5);
  font-family: 'Ashtanga Serif', 'Songti SC', STSong, serif;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  transition: all 120ms ease;
}

.audio-seek-step.active {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  color: #FFFFFF;
}

@keyframes timer-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

@keyframes session-ripple {
  0% { opacity: 0.55; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.5); }
}
