.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 48rpx calc(180rpx + env(safe-area-inset-bottom));
}

.profile-topbar {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding-top: 40rpx;
}

.top-icon-button,
.sheet-close,
.modal-close {
  align-items: center;
  color: #68716C;
  display: flex;
  font-size: 36rpx;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.top-icon-image {
  height: 40rpx;
  width: 40rpx;
}

.settings-entry {
  margin-left: auto;
}

.profile-state {
  color: #868C88;
  font-size: 25rpx;
  padding: 80rpx 0;
  text-align: center;
}

.identity-section {
  align-items: center;
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
  text-align: center;
}

.avatar-wrap,
.profile-edit-avatar {
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.25);
  display: flex;
  height: 160rpx;
  justify-content: center;
  margin-bottom: 22rpx;
  overflow: hidden;
  width: 160rpx;
}

.avatar-image {
  height: 100%;
  width: 100%;
}

.avatar-symbol {
  color: #FFFFFF;
  font-size: 76rpx;
  line-height: 1;
}

.avatar-symbol.small {
  font-size: 58rpx;
}

.avatar-icon {
  height: 80rpx;
  width: 80rpx;
}

.name-row {
  align-items: center;
  display: flex;
  gap: 14rpx;
  justify-content: center;
}

.profile-name {
  color: #2D5A27;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 40rpx;
  line-height: 1.2;
}

.pro-badge {
  background: #E8EDE7;
  border: 1rpx solid #E5E5E5;
  border-radius: 999rpx;
  color: #6B7280;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 16rpx;
}

.pro-badge.active {
  background: linear-gradient(to right, #C1A268, #D4AF37);
  border-color: transparent;
  color: #FFFFFF;
}

.membership-pill {
  align-items: center;
  border: 1rpx solid rgba(193, 162, 104, 0.3);
  border-radius: 999rpx;
  color: #8B7355;
  display: flex;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 23rpx;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 14rpx 28rpx;
}

.membership-pill.upgrade,
.membership-pill.active {
  background: linear-gradient(to right, #F9F7F2, #F5F0E8);
}

.membership-pill.muted {
  color: #9CA3AF;
}

.pill-icon,
.chevron {
  color: #C1A268;
}

.profile-id {
  color: #9CA3AF;
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.profile-signature {
  color: #68716C;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.total-stats-grid {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-bottom: 24rpx;
}

.total-stat-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E2D8;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 18rpx rgba(42, 75, 60, 0.08);
  padding: 28rpx 12rpx;
  text-align: center;
}

.total-stat-value {
  color: #2D5A27;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 44rpx;
  line-height: 1;
}

.total-stat-label {
  color: #68716C;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 12rpx;
}

.heatmap-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E2D8;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 18rpx rgba(42, 75, 60, 0.08);
  overflow: hidden;
}

.heatmap-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 28rpx 30rpx 20rpx;
}

.heatmap-title {
  color: #78716C;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 25rpx;
  font-style: italic;
}

.empty-heatmap {
  color: #A8A29E;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 25rpx;
  padding: 0 0 30rpx;
  text-align: center;
}

.heatmap-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 30rpx 30rpx;
}

.heatmap-row {
  align-items: flex-start;
  display: flex;
  gap: 8rpx;
}

.month-label {
  color: #A8A29E;
  flex-shrink: 0;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 22rpx;
  font-style: italic;
  line-height: 24rpx;
  width: 54rpx;
}

.dot-grid {
  display: grid;
  flex: 1;
  gap: 8rpx;
  grid-template-columns: repeat(16, minmax(0, 1fr));
}

.heat-dot {
  align-items: center;
  background: #F5F2EC;
  border-radius: 999rpx;
  display: flex;
  height: 20rpx;
  justify-content: center;
  overflow: visible;
  position: relative;
  width: 20rpx;
}

.heat-dot.green-gradient-1 {
  background: #C4CCBE;
}

.heat-dot.green-gradient-2 {
  background: #8DA688;
}

.heat-dot.green-gradient-3 {
  background: #4A7A44;
}

.heat-dot.green-gradient-4 {
  background: #1A3D1A;
}

.moon-dot-image {
  border-radius: 999rpx;
  height: 22rpx;
  width: 22rpx;
}

.moon-practiced {
  box-shadow: 0 4rpx 14rpx rgba(45, 90, 39, 0.3);
}

.moon-spark {
  background: #FFE066;
  border-radius: 999rpx;
  box-shadow: 0 0 8rpx rgba(255, 224, 102, 0.8);
  height: 5rpx;
  position: absolute;
  width: 5rpx;
}

.sheet-mask,
.center-mask {
  background: rgba(0, 0, 0, 0.3);
  bottom: 0;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 80;
}

.settings-sheet {
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  bottom: 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  left: 0;
  max-height: calc(100vh - 64rpx);
  overflow-y: auto;
  padding: 38rpx 42rpx calc(52rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 90;
}

.sheet-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 34rpx;
}

.settings-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.settings-tab {
  background: #F5F2EC;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  color: #2A4B3C;
  flex: 1;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  line-height: 1;
  padding: 18rpx 8rpx;
  text-align: center;
}

.settings-tab.active {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.25);
  color: #FFFFFF;
}

.settings-tab.membership-tab.active {
  background-image: linear-gradient(to right, #C1A268, #D4AF37);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(193, 162, 104, 0.25);
  color: #FFFFFF;
}

.settings-panel {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.profile-edit-avatar {
  background: #F5F2EC;
  border: 2rpx solid rgba(45, 90, 39, 0.2);
  box-shadow: none;
  height: 192rpx;
  margin: 0 auto 10rpx;
  overflow: visible;
  position: relative;
  overflow: visible;
  width: 192rpx;
}

.profile-edit-avatar-image { border-radius: 999rpx; height: 100%; width: 100%; }

.avatar-loading-mask { align-items: center; background: rgba(245, 242, 236, .68); border-radius: 999rpx; bottom: 0; display: flex; justify-content: center; left: 0; overflow: hidden; position: absolute; right: 0; top: 0; }
.avatar-spinner, .camera-spinner { animation: avatar-spin .85s linear infinite; border: 4rpx solid rgba(134, 140, 136, .28); border-radius: 50%; border-top-color: #2D5A27; box-sizing: border-box; height: 40rpx; width: 40rpx; }
.camera-spinner { border-color: rgba(255, 255, 255, .35); border-top-color: #FFFFFF; height: 26rpx; width: 26rpx; }
@keyframes avatar-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.profile-edit-user-icon {
  height: 58rpx;
  width: 58rpx;
}

.camera-dot {
  align-items: center;
  background: #2D5A27;
  border: 4rpx solid #FFFFFF;
  border-radius: 999rpx;
  bottom: 0;
  color: #FFFFFF;
  display: flex;
  font-size: 22rpx;
  height: 58rpx;
  justify-content: center;
  position: absolute;
  right: 0;
  width: 58rpx;
}

.camera-icon {
  height: 30rpx;
  width: 30rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 25rpx;
}

.profile-input,
.modal-input {
  background: #F5F2EC;
  border: 1rpx solid #E7E2D8;
  border-radius: 32rpx;
  box-sizing: border-box;
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 26rpx;
  height: 88rpx;
  padding: 0 24rpx;
  width: 100%;
}

.signature-input {
  height: 88rpx;
}

.history-section {
  padding-top: 8rpx;
}

.history-header {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.history-title-row {
  align-items: center;
  display: flex;
  gap: 8rpx;
}

.history-icon {
  height: 28rpx;
  width: 28rpx;
}

.history-title {
  color: #2A4B3C;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 27rpx;
}

.history-hours {
  color: #2D5A27;
  font-size: 23rpx;
  font-weight: 500;
}

.history-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.history-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E2D8;
  border-radius: 24rpx;
  box-sizing: border-box;
  padding: 24rpx 12rpx;
  text-align: center;
}

.history-input {
  background: transparent;
  color: #2D5A27;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 48rpx;
  height: 56rpx;
  line-height: 56rpx;
  min-height: 0;
  padding: 0;
  text-align: center;
  width: 100%;
}

.history-label {
  color: #68716C;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 20rpx;
  margin-top: 8rpx;
}

.history-note {
  color: rgba(104, 113, 108, 0.7);
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 20rpx;
  margin-top: 14rpx;
  text-align: center;
}

.green-button,
.gold-button,
.secondary-button,
.ghost-button,
.dashed-button {
  align-items: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 27rpx;
  height: 96rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  width: 100%;
}

.green-button {
  background-image: linear-gradient(to top left, rgba(74, 122, 68, 0.7), rgba(45, 90, 39, 0.85));
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.25);
  color: #FFFFFF;
}

.gold-button {
  background: linear-gradient(to bottom right, #C1A268, #D4AF37);
  color: #FFFFFF;
}

.secondary-button,
.ghost-button,
.dashed-button {
  background: #F5F2EC;
  border: 1rpx solid #E7E2D8;
  color: #2A4B3C;
}

.ghost-button {
  background: transparent;
  color: #68716C;
  font-size: 23rpx;
  height: 68rpx;
}

.dashed-button {
  background: transparent;
  border-style: dashed;
  color: #68716C;
}

.membership-card-shell {
  background: linear-gradient(to bottom right, #F9F7F2, #F5F0E8);
  border: 1rpx solid rgba(193, 162, 104, 0.2);
  border-radius: 40rpx;
  padding: 34rpx;
}

.membership-card-head {
  align-items: center;
  display: flex;
  gap: 20rpx;
}

.membership-card-copy {
  min-width: 0;
}

.membership-order-card {
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E8E8E3;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(42, 75, 60, 0.05);
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  width: 100%;
}

.membership-order-card-left {
  align-items: center;
  display: flex;
  gap: 18rpx;
  min-width: 0;
}

.membership-order-icon {
  align-items: center;
  background: linear-gradient(135deg, rgba(193, 162, 104, 0.16), rgba(212, 175, 55, 0.08));
  border: 1rpx solid rgba(193, 162, 104, 0.22);
  border-radius: 20rpx;
  display: flex;
  flex: none;
  height: 68rpx;
  justify-content: center;
  width: 68rpx;
}

.membership-order-icon image {
  height: 34rpx;
  width: 34rpx;
}

.membership-order-copy {
  min-width: 0;
}

.membership-order-title,
.membership-order-subtitle {
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
}

.membership-order-title {
  color: #34483D;
  font-size: 26rpx;
  font-weight: 500;
}

.membership-order-subtitle {
  color: #8B918D;
  font-size: 21rpx;
  margin-top: 5rpx;
}

.membership-order-chevron {
  flex: none;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.65;
  width: 32rpx;
}

.gold-icon,
.setting-icon {
  align-items: center;
  border-radius: 20rpx;
  display: flex;
  flex-shrink: 0;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.gold-icon {
  background: linear-gradient(to bottom right, #C1A268, #D4AF37);
  color: #FFFFFF;
}

.gold-icon.large {
  font-size: 42rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  width: 100rpx;
}

.membership-title {
  color: #8B7355;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 34rpx;
}

.membership-subtitle {
  color: #8B7355;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.membership-status-title {
  color: #6B5A47;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 26rpx;
  font-weight: 500;
  margin-top: 6rpx;
}

.benefit-table {
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(193, 162, 104, 0.15);
  border-radius: 32rpx;
  margin-top: 28rpx;
  overflow: hidden;
}

.benefit-row {
  align-items: center;
  border-top: 1rpx solid rgba(193, 162, 104, 0.1);
  color: #6B5A47;
  display: grid;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  grid-template-columns: 1.25fr 0.8fr 0.8fr;
}

.benefit-row.header {
  background: #F5F0E8;
  border-top: 0;
  color: #8B7355;
  font-size: 21rpx;
}

.benefit-row text {
  padding: 18rpx 16rpx;
  text-align: center;
}

.benefit-row text:first-child {
  text-align: left;
}

.benefit-pro {
  color: #9A7438;
  font-weight: 600;
}

.price-grid {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 24rpx;
}

.price-card {
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(193, 162, 104, 0.15);
  border-radius: 32rpx;
  padding: 28rpx 12rpx;
  position: relative;
  text-align: center;
}

.price-card.recommended {
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(193, 162, 104, 0.35);
  box-shadow: 0 12rpx 36rpx rgba(193, 162, 104, 0.14);
}

.recommend-tag {
  background: rgba(193, 162, 104, 0.15);
  border-radius: 999rpx;
  color: #9A7438;
  font-size: 19rpx;
  padding: 4rpx 12rpx;
  position: absolute;
  right: 12rpx;
  top: 12rpx;
}

button::after {
  border: 0;
}

.price {
  color: #6B5A47;
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.price-label,
.price-days {
  color: #6B5A47;
  display: block;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.price-days {
  color: #8B7355;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.local-storage-notice {
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #B45309;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  margin-bottom: 36rpx;
  padding: 28rpx;
}

.local-storage-title {
  color: #92400E;
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.local-storage-copy {
  display: block;
  font-size: 22rpx;
  line-height: 1.65;
}

.notice-divider-row,
.notice-status-row {
  align-items: center;
  border-top: 1rpx solid #FDE68A;
  display: flex;
  font-size: 21rpx;
  gap: 12rpx;
  line-height: 1.55;
  margin-top: 22rpx;
  padding-top: 20rpx;
}

.notice-divider-row image {
  flex: 0 0 auto;
  height: 28rpx;
  width: 28rpx;
}

.sync-status-dot {
  border-radius: 50%;
  flex: 0 0 auto;
  height: 12rpx;
  width: 12rpx;
}

.sync-status-dot.idle {
  background: #A8A29E;
}

.sync-status-dot.syncing { background: #60A5FA; }
.sync-status-dot.success { background: #4ADE80; }
.sync-status-dot.error { background: #F87171; }

.cloud-storage-notice {
  background: linear-gradient(135deg, rgba(255, 251, 235, 0.8), rgba(255, 247, 237, 0.8));
  border: 1rpx solid rgba(253, 230, 138, 0.5);
  border-radius: 24rpx;
  box-sizing: border-box;
  font-family: 'Ashtanga Serif', Georgia, 'Times New Roman', serif;
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.bound-email-row,
.cloud-title-row,
.cloud-sync-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
}

.bound-email-row image,
.cloud-title-row image {
  flex: 0 0 auto;
  height: 28rpx;
  width: 28rpx;
}

.bound-email-title,
.cloud-title-row text {
  color: #2A4B3C;
  font-size: 24rpx;
  font-weight: 600;
}

.bound-email-value {
  color: #868C88;
  flex: 1;
  font-size: 20rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cloud-title-row {
  border-top: 1rpx solid rgba(253, 230, 138, 0.5);
  margin-top: 20rpx;
  padding-top: 20rpx;
}

.cloud-benefits {
  color: #68716C;
  display: flex;
  flex-direction: column;
  font-size: 20rpx;
  gap: 4rpx;
  line-height: 1.55;
  margin: 14rpx 0 18rpx;
}

.cloud-sync-row {
