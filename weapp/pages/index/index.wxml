<view class="container">
  <view class="header">
    <image class="auth-logo" src="/images/icon-green.png" mode="aspectFit" />
    <text class="eyebrow">ASHTANGA JOURNAL</text>
    <text class="title">熬汤日记</text>
    <text class="subtitle">阿斯汤加练习记录工具</text>
  </view>

  <view wx:if="{{authLoading}}" class="panel loading-panel">
    <view class="spinner"></view>
    <text>正在检查账号会话…</text>
  </view>

  <view wx:elif="{{isLoggedIn}}" class="panel loading-panel">
    <view class="spinner"></view>
    <text>正在进入熬汤日记…</text>
  </view>

  <view wx:else class="panel auth-panel">
    <block wx:if="{{mode !== 'forgot-password'}}">
    <view class="tabs">
      <view
        class="tab {{mode === 'login' ? 'active' : ''}}"
        data-mode="login"
        bindtap="switchMode"
      >登录</view>
      <view
        class="tab {{mode === 'register' ? 'active' : ''}}"
        data-mode="register"
        bindtap="switchMode"
      >注册</view>
    </view>

    <text class="panel-title">
      {{mode === 'login' ? '登录已有账号' : '创建熬汤日记账号'}}
    </text>
    <text class="hint">
      {{mode === 'login'
        ? '使用与网页版相同的邮箱和密码'
        : '注册后，网页和小程序使用同一份数据'}}
    </text>

    <view class="field">
      <text class="label">邮箱地址</text>
      <view class="field-input-wrap">
        <image class="field-icon" src="/images/icons/auth-mail.svg" mode="aspectFit" />
        <input class="input icon-input" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" />
      </view>
    </view>

    <view class="field">
      <text class="label">密码</text>
      <view class="field-input-wrap">
        <image class="field-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" />
        <input class="input icon-input" password placeholder="至少 8 位，包含字母和数字" value="{{password}}" bindinput="onPasswordInput" />
      </view>
      <text wx:if="{{mode === 'login'}}" class="forgot-link" bindtap="openForgotPassword">忘记密码？</text>
    </view>

    <view wx:if="{{mode === 'register' && password}}" class="password-requirements">
      <text>密码要求：</text>
      <text class="{{passwordLengthValid ? 'valid' : 'invalid'}}">{{passwordLengthValid ? '✓' : '✗'}} 至少 8 位字符</text>
      <text class="{{passwordLetterValid ? 'valid' : 'invalid'}}">{{passwordLetterValid ? '✓' : '✗'}} 包含字母</text>
      <text class="{{passwordNumberValid ? 'valid' : 'invalid'}}">{{passwordNumberValid ? '✓' : '✗'}} 包含数字</text>
    </view>

    <view wx:if="{{mode === 'register'}}" class="field">
      <text class="label">邮箱验证码</text>
      <view class="code-row">
        <input
          class="input code-input"
          type="number"
          maxlength="6"
          placeholder="6 位验证码"
          value="{{verificationCode}}"
          bindinput="onCodeInput"
        />
        <button
          class="code-button"
          bindtap="sendCode"
          loading="{{codeLoading}}"
          disabled="{{codeLoading}}"
        >获取验证码</button>
      </view>
    </view>

    <view wx:if="{{message}}" class="message {{messageType}}">
      {{message}}
    </view>

    <button
      class="btn-primary"
      bindtap="submitAuth"
      loading="{{submitLoading}}"
      disabled="{{submitLoading || !hasAgreed}}"
    >{{mode === 'login' ? '登录' : '注册并登录'}}</button>

    <view class="guest-divider">
      <view class="guest-divider-line"></view>
      <text>或者</text>
      <view class="guest-divider-line"></view>
    </view>

    <button class="guest-button" bindtap="enterGuest">暂不登录，直接开始练习</button>
    <text class="guest-hint">游客记录只保存在本机，登录后可进行云端备份</text>

    <checkbox-group class="agreement-row" bindchange="onAgreementChange">
      <checkbox
        class="agreement-checkbox"
        value="agreed"
        checked="{{hasAgreed}}"
        color="#2A4B3C"
      />
      <view class="agreement-copy">
        <text>我已阅读并同意</text>
        <text
          class="agreement-link"
          data-type="terms"
          catchtap="onOpenAgreement"
        >《用户协议》</text>
        <text>和</text>
        <text
          class="agreement-link"
          data-type="privacy"
          catchtap="onOpenAgreement"
        >《隐私政策》</text>
      </view>
    </checkbox-group>
    </block>

    <block wx:else>
      <view class="forgot-header">
        <text class="panel-title">🔑 忘记密码</text>
        <text class="back-login" bindtap="backToLogin">返回登录</text>
      </view>

      <block wx:if="{{forgotStep === 'email'}}">
        <view class="field">
          <text class="label">邮箱地址</text>
          <view class="field-input-wrap">
            <image class="field-icon" src="/images/icons/auth-mail.svg" mode="aspectFit" />
            <input class="input icon-input" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" />
          </view>
        </view>
        <button class="btn-primary rounded-button" bindtap="sendResetCode" loading="{{codeLoading}}" disabled="{{codeLoading || resendCountdown > 0}}">{{codeLoading ? '发送中...' : resendCountdown > 0 ? '重新发送（' + resendCountdown + 's）' : '发送验证码'}}</button>
      </block>

      <block wx:elif="{{forgotStep === 'verify'}}">
        <view class="verification-notice">
          <text>验证码已发送到：</text>
          <text>{{email}}</text>
        </view>
        <view class="field">
          <text class="label">请输入 6 位验证码</text>
          <input class="input verify-input" type="number" maxlength="6" placeholder="______" value="{{verificationCode}}" bindinput="onCodeInput" />
        </view>
        <button class="btn-primary rounded-button" bindtap="verifyForgotCode" loading="{{submitLoading}}" disabled="{{submitLoading || verificationCode.length !== 6}}">下一步</button>
        <text class="resend-link {{resendCountdown > 0 ? 'disabled' : ''}}" bindtap="sendResetCode">{{resendCountdown > 0 ? '重新发送（' + resendCountdown + 's）' : '重新发送验证码'}}</text>
      </block>

      <block wx:else>
        <view class="verification-success"><text>✓ 验证成功，请设置新密码</text></view>
        <view class="field">
          <text class="label">新密码</text>
          <view class="field-input-wrap"><image class="field-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="input icon-input" password placeholder="至少 8 位，包含字母和数字" value="{{newPassword}}" bindinput="onNewPasswordInput" /></view>
        </view>
        <view class="field">
          <text class="label">确认新密码</text>
          <view class="field-input-wrap"><image class="field-icon" src="/images/icons/auth-lock.svg" mode="aspectFit" /><input class="input icon-input" password placeholder="再次输入新密码" value="{{confirmNewPassword}}" bindinput="onConfirmNewPasswordInput" /></view>
        </view>
        <button class="btn-primary rounded-button" bindtap="submitNewPassword" loading="{{submitLoading}}" disabled="{{submitLoading}}">确认修改</button>
      </block>

      <view wx:if="{{message}}" class="message {{messageType}}">{{message}}</view>
    </block>
  </view>
</view>

<view
  wx:if="{{agreementVisible}}"
  class="agreement-mask"
  catchtouchmove="preventTouchMove"
  bindtap="onCloseAgreement"
>
  <view class="agreement-modal" catchtap="preventTouchMove">
    <view class="agreement-modal-header">
      <view>
        <text class="agreement-modal-eyebrow">{{agreement.englishTitle}}</text>
        <text class="agreement-modal-title">{{agreement.title}}</text>
      </view>
      <text class="agreement-close" bindtap="onCloseAgreement">×</text>
    </view>

    <scroll-view
      class="agreement-scroll"
      scroll-y
      enhanced
      show-scrollbar
    >
      <text class="agreement-date">更新日期：{{agreement.updatedAt}}</text>
      <block wx:for="{{agreement.intro}}" wx:key="*this">
        <text class="agreement-paragraph">{{item}}</text>
      </block>
      <block wx:for="{{agreement.sections}}" wx:key="title">
        <view class="agreement-section {{item.important ? 'important' : ''}}">
          <text wx:if="{{item.important}}" class="agreement-important-label">
            重要提示
          </text>
          <text class="agreement-section-title">{{item.title}}</text>
          <block wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this">
            <text class="agreement-paragraph">{{paragraph}}</text>
          </block>
        </view>
      </block>
      <view class="agreement-scroll-spacer"></view>
    </scroll-view>

    <button class="agreement-read-button" bindtap="onCloseAgreement">
      我已阅读，返回勾选
    </button>
  </view>
</view>
